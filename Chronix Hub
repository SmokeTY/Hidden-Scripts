task.spawn(function()
	local gid = game.GameId
	local m = findMatch(catalog, gid)
	if m then
		if run(m) then
			if G.Chronix == Chronix then G.Chronix = nil end
			return
		end
		frame()
		buildPanel(false, m)
		return
	end
	local body = fetch(RAW .. "games.json")
	if body then
		local okJ, data = pcall(function() return HttpService:JSONDecode(body) end)
		if okJ and type(data) == "table" and type(data.scripts) == "table" and #data.scripts > 0 then
			local m2 = findMatch(data.scripts, gid)
			if m2 then
				if run(m2) then
					if G.Chronix == Chronix then G.Chronix = nil end
					return
				end
				frame()
				buildPanel(false, m2)
				return
			end
		end
	end
	frame()
	buildPanel(true, nil)
end)
