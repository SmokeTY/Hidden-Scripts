local function frame()
	local ok = pcall(function() task.wait() end)
	if not ok then pcall(function() RunService.Heartbeat:Wait() end) end
end

local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {Title = "Chronix", Text = text, Duration = 5})
	end)
end

local function fetch(url)
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and type(res) == "string" and #res > 0 then return res end
	return nil
end

local httpRequest = (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request) or http_request or request
local function hasRequest()
	return type(httpRequest) == "function"
end

local function gameName()
	local nm
	pcall(function()
		local info = MarketplaceService:GetProductInfo(game.PlaceId)
		if info and info.Name then nm = info.Name end
	end)
	return nm or ("PlaceId " .. tostring(game.PlaceId))
end

local function userField()
	local lp = Players.LocalPlayer
	local nm = (lp and lp.Name) or "?"
	local uid = (lp and lp.UserId) or 0
	return nm .. " (" .. tostring(uid) .. ")"
end

local function postWebhook(embed)
	if not hasRequest() then return false end
	local body
	local okE = pcall(function()
		body = HttpService:JSONEncode({ username = "Chronix Hub", embeds = { embed } })
	end)
	if not okE then return false end
	local ok, res = pcall(function()
		return httpRequest({
			Url = WEBHOOK,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Chronix" },
			Body = body,
		})
	end)
	if not ok then return false end
	if type(res) == "table" then
		local code = res.StatusCode or res.status_code
		if code and (code < 200 or code >= 300) then return false end
	end
	return true
end

local function requestedBefore(gid)
	if G.ChronixRequested and G.ChronixRequested[gid] then return true end
	local seen = false
	pcall(function()
		if isfile and isfile("chronix_requested.json") then
			local d = HttpService:JSONDecode(readfile("chronix_requested.json"))
			if type(d) == "table" then
				for _, v in ipairs(d) do if v == gid then seen = true break end end
			end
		end
	end)
	return seen
end

local function markRequested(gid)
	G.ChronixRequested = G.ChronixRequested or {}
	G.ChronixRequested[gid] = true
	pcall(function()
		if not writefile then return end
		local list = {}
		if isfile and isfile("chronix_requested.json") then
			local ok, d = pcall(function() return HttpService:JSONDecode(readfile("chronix_requested.json")) end)
			if ok and type(d) == "table" then list = d end
		end
		local found = false
		for _, v in ipairs(list) do if v == gid then found = true break end end
		if not found then list[#list + 1] = gid end
		writefile("chronix_requested.json", HttpService:JSONEncode(list))
	end)
end

local function autoRequest()
	local gid = game.GameId
	if requestedBefore(gid) then return end
	local ok = postWebhook({
		title = "Hub used in unsupported game",
		description = "A user ran Chronix Hub in a game with no script.",
		color = 15844367,
		fields = {
			{ name = "Game", value = gameName(), inline = true },
			{ name = "PlaceId", value = tostring(game.PlaceId), inline = true },
			{ name = "GameId", value = tostring(gid), inline = true },
			{ name = "User", value = userField(), inline = false },
		},
	})
	if ok then markRequested(gid) end
	return ok
end

local function manualRequest(note)
	if note == nil or note == "" then note = "(no note)" end
	if #note > 1000 then note = note:sub(1, 1000) end
	return postWebhook({
		title = "Game request",
		description = note,
		color = 9727231,
		fields = {
			{ name = "Game", value = gameName(), inline = true },
			{ name = "PlaceId", value = tostring(game.PlaceId), inline = true },
			{ name = "GameId", value = tostring(game.GameId), inline = true },
			{ name = "User", value = userField(), inline = false },
		},
	})
end

local function protectParent(sg)
	local okHui, hui = pcall(function() return gethui() end)
	if okHui and typeof(hui) == "Instance" then
		sg.Parent = hui
		return
	end
	if syn and type(syn.protect_gui) == "function" then pcall(syn.protect_gui, sg) end
	if pcall(function() sg.Parent = game:GetService("CoreGui") end) and sg.Parent then return end
	local lp = Players.LocalPlayer
	local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
	if pg then sg.Parent = pg end
end

